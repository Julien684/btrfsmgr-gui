<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>btrfsmgr-gui</vendor>
  <action id="org.btrfsmgr.gui">
    <description>Gérer les instantanés BTRFS (btrfsmgr-gui)</description>
    <message>Authentification requise pour gérer les instantanés BTRFS</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <!-- exec.path : permet « pkexec btrfsmgr-gui » -->
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/btrfsmgr-gui</annotate>
    <!-- allow_gui : préserve DISPLAY / WAYLAND_DISPLAY / XAUTHORITY / XDG_RUNTIME_DIR
         pour que le processus root puisse initialiser GTK. -->
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
